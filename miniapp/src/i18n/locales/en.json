    "items": {
      "times": {
        "q": "Why may the prayer time differ?",
        "a": "Time may vary based on the calculation method (e.g., ISNA, MWL) and geographical coordinates. Check the calculation settings in the app."
      },
      "method": {
        "q": "Can I change the calculation method?",
        "a": "Yes, in the app settings you can choose from several calculation methods accepted in the Islamic world."
      },
      "offline": {
        "q": "Does the app work without internet?",
        "a": "Base functions like the prayer schedule and Quran (after first download) work offline. Some features may require a connection."
      },
      "notifications": {
        "q": "Why am I not receiving notifications?",
        "a": "Ensure notifications are enabled in your phone and app settings. Also, check Disturbed mode."
      },
      "location": {
        "q": "How to change location manually?",
        "a": "Go to the Location section, disable auto-detection, and select a city from the list or specify coordinates."
      },
      "theme": {
        "q": "How to switch dark theme?",
        "a": "The app automatically adapts to your device theme or you can change it in the Appearance settings."
      },
      "language": {
        "q": "Can I change the language?",
        "a": "Yes, the app supports several languages. You can change the interface language in the Language Settings section."
      }
    }
